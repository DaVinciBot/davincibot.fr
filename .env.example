# Projet Supabase
PUBLIC_SUPABASE_URL=https://project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xx

# Service auth central (prod : https://auth.davincibot.fr)
PUBLIC_AUTH_BASE_URL=http://localhost:5177

# Préfixe optionnel des noms de cookies (ex. dev-) : isole un environnement qui
# partage le domaine racine avec la prod (dev.davincibot.fr). Vide en prod.
PUBLIC_COOKIE_PREFIX=

# Prod uniquement, derrière Traefik (adapter-node) :
# ORIGIN=https://davincibot.fr
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Clé service Supabase — requise uniquement par le panneau RBAC de développement.
SUPABASE_SECRET_KEY=

# --- Panneau RBAC de développement (jamais en production) --------------------
# Sans DEV_RBAC_PANEL=true la route /api/dev/rbac répond 404.
DEV_RBAC_PANEL=
# Optionnel : fichier des profils enregistrés
# (défaut ~/.davincibot/dev-rbac-snapshots.json, partagé par les quatre apps)
DEV_RBAC_SNAPSHOTS_PATH=
# Optionnel : références de projets Supabase autorisées, séparées par des virgules
DEV_RBAC_ALLOWED_PROJECT_REFS=
