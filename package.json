{
	"name": "davincibot.fr",
	"version": "1.0.0",
	"private": false,
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "vite dev --host",
		"dev:proxy": "docker compose -f docker-compose.dev.yml up",
		"dev:proxy:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
		"dev:all": "concurrently -n web,admin,formation -c green,yellow,magenta \"npm run dev\" \"npm --prefix ../cash run dev\" \"npm --prefix ../formation run dev\"",
		"dev:all:docker": "concurrently -n proxy,web,admin,formation -c cyan,green,yellow,magenta \"npm run dev:proxy\" \"npm run dev\" \"npm --prefix ../cash run dev\" \"npm --prefix ../formation run dev\"",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . --max-warnings=0",
		"format": "prettier --write .",
		"test:unit": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"ci": "pnpm check && pnpm lint && pnpm test:unit && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/eslint": "^9.6.0",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^4.2.20",
		"svelte-check": "^4.3.4",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^3.4.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^5.4.21",
		"vitest": "^3.2.4"
	},
	"type": "module",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@supabase/phoenix": "^0.4.0",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.97.0",
		"animejs": "^4.1.3",
		"autoprefixer": "^10.4.20",
		"carta-md": "^3.6.1",
		"chart.js": "^4.4.4",
		"concurrently": "^9.2.1",
		"crypto-js": "^4.2.0",
		"express": "^5.2.1",
		"http-proxy-middleware": "^3.0.5",
		"marked": "^16.2.0",
		"mdast-util-to-string": "^4.0.0",
		"postcss": "^8.4.40",
		"remark-parse": "^11.0.0",
		"sanitize-html": "^2.17.0",
		"svelte-chartjs": "^3.1.5",
		"tailwind-merge": "^2.4.0",
		"unified": "^11.0.5"
	}
}
