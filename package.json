{
	"name": "davincibot.fr",
	"version": "1.0.0",
	"private": false,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev --host",
		"dev:proxy": "docker compose -f docker-compose.dev.yml up",
		"dev:proxy:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
		"dev:all": "concurrently -n web,admin,formation -c green,yellow,magenta \"npm run dev\" \"npm --prefix ../cash run dev\" \"npm --prefix ../formation run dev\"",
		"dev:all:docker": "concurrently -n proxy,web,admin,formation -c cyan,green,yellow,magenta \"npm run dev:proxy\" \"npm run dev\" \"npm --prefix ../cash run dev\" \"npm --prefix ../formation run dev\"",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint . --max-warnings=0",
		"format": "prettier --write .",
		"test:unit": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"ci": "pnpm check && pnpm lint && pnpm test:unit && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/eslint": "^9.6.1",
		"@vitest/coverage-v8": "^4.1.7",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"svelte-preprocess": "^6.0.4",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	},
	"type": "module",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@supabase/phoenix": "^0.4.2",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.106.1",
		"animejs": "^4.4.1",
		"autoprefixer": "^10.5.0",
		"carta-md": "^4.11.2",
		"chart.js": "^4.5.1",
		"concurrently": "^9.2.1",
		"crypto-js": "^4.2.0",
		"express": "^5.2.1",
		"http-proxy-middleware": "^4.0.0",
		"marked": "^18.0.4",
		"mdast-util-to-string": "^4.0.0",
		"postcss": "^8.5.15",
		"remark-parse": "^11.0.0",
		"sanitize-html": "^2.17.4",
		"svelte-chartjs": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"unified": "^11.0.5"
	}
}
